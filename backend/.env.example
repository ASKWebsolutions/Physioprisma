# =============================================================
# Physioprisma Backend - environment variables
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# =============================================================

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma separated list of allowed origins for CORS (leave blank for same-origin only)
CORS_ORIGIN=

# --- DNS (optional) - comma separated resolvers, e.g. 8.8.8.8,1.1.1.1
# Leave blank unless you see "[dns] System resolver is not reachable" in the logs.
DNS_SERVERS=

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/physioprisma?retryWrites=true&w=majority

# --- Auth ---
# Use a long random string, e.g. `openssl rand -hex 64`
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Admin account (seeded automatically on server start) ---
ADMIN_NAME=Physioprisma Admin
ADMIN_EMAIL=admin@physioprisma.com
ADMIN_PASSWORD="ChangeMe#12345"

# Set to true to force ADMIN_PASSWORD from this file onto the admin account on every boot
ADMIN_FORCE_RESET=

# --- Cloudinary (uploads: course images/videos, blog covers, gallery) ---
# NOTE: if a value ever contains # or spaces, wrap it in double quotes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Max lesson/gallery video upload (MB). Cloudinary Free plan limit is 100,
# Plus and above allow 2048. Image uploads are capped at 8 MB.
MAX_VIDEO_MB=100

# --- Business rules ---
# Ambassador reward per confirmed enrollment (PKR)
REWARD_PER_ENROLLMENT=500
