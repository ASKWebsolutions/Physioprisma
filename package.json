{
  "name": "physioprisma",
  "version": "1.0.0",
  "description": "Physioprisma website (static frontend) + Express/MongoDB API, deployed as one Vercel project.",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend run start",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend run test",
    "test:all": "npm --prefix backend run test:all",
    "vercel:check": "node backend/scripts/vercel-check.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0"
  }
}
