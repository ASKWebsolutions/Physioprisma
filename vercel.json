{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/api", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/frontend/home.html" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
